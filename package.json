{
  "name": "media-converter-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:js": "bun build ./assets/ts/main.ts --outdir ./internal/web/static --entry-naming app.min.js --target browser --minify",
    "build:css": "sass ./assets/scss/app.scss ./internal/web/static/app.min.css --style=compressed --no-source-map",
    "build": "bun run typecheck && bun run build:js && bun run build:css",
    "build:js:dev": "bun build ./assets/ts/main.ts --outdir ./internal/web/static --entry-naming app.min.js --target browser --sourcemap=external",
    "build:css:dev": "sass ./assets/scss/app.scss ./internal/web/static/app.min.css --style=expanded --source-map",
    "build:dev": "bun run typecheck && bun run build:js:dev && bun run build:css:dev",
    "watch:js": "bun build ./assets/ts/main.ts --outdir ./internal/web/static --entry-naming app.min.js --target browser --sourcemap=external --watch",
    "watch:css": "sass ./assets/scss/app.scss ./internal/web/static/app.min.css --style=expanded --source-map --watch"
  },
  "devDependencies": {
    "sass": "1.105.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "htmx.org": "^2.0.11"
  }
}
