package view

templ PDFExtractWorkspace() {
	<div data-pdf-workspace="extract">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					Seiten extrahieren
				</h3>
				<p>
					Wähle die Seiten aus, die in eine neue PDF übernommen werden sollen.
					Die ursprüngliche Reihenfolge der ausgewählten Seiten bleibt erhalten.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-extract-drop-zone"
			for="pdf-extract-file"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDF auswählen
			</strong>
			<span>
				oder eine Datei hier ablegen
			</span>
			<small>
				Max. 512 MiB
			</small>
			<input
				id="pdf-extract-file"
				type="file"
				accept="application/pdf,.pdf"
				hidden
			/>
		</label>
		<div
			id="pdf-extract-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-extract-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span>
					Datei wird hochgeladen und analysiert.
				</span>
			</div>
		</div>
		<section
			id="pdf-extract-editor"
			class="pdf-selection-editor"
			hidden
		>
			<header class="pdf-selection-header">
				<div>
					<strong id="pdf-extract-filename"></strong>
					<span id="pdf-extract-meta"></span>
				</div>
				<button
					id="pdf-extract-reset-file"
					class="pdf-button-secondary"
					type="button"
				>
					Andere PDF
				</button>
			</header>
			<div class="pdf-selection-toolbar">
				<div>
					<strong>
						Seitenauswahl
					</strong>
					<span id="pdf-extract-selected-count">
						0 Seiten ausgewählt
					</span>
				</div>
				<div class="pdf-selection-actions">
					<button
						id="pdf-extract-select-all"
						class="pdf-button-secondary"
						type="button"
					>
						Alle auswählen
					</button>
					<button
						id="pdf-extract-clear-selection"
						class="pdf-button-secondary"
						type="button"
						disabled
					>
						Auswahl aufheben
					</button>
				</div>
			</div>
			<div
				id="pdf-extract-pages"
				class="pdf-page-selector"
				aria-label="PDF-Seiten auswählen"
			></div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						extrahiert.pdf
					</span>
				</div>
				<button
					id="pdf-extract-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					Ausgewählte Seiten extrahieren
				</button>
			</div>
		</section>
		<div
			id="pdf-extract-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird erstellt …
				</strong>
				<span>
					Die ausgewählten Seiten werden übernommen.
				</span>
			</div>
		</div>
		@PDFSelectablePageTemplate()
	</div>
}
