package view

templ PDFMergeWorkspace() {
	<div data-pdf-workspace="merge">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					PDFs zusammenfügen
				</h3>
				<p>
					Wähle mindestens zwei PDF-Dateien.
					Die Reihenfolge der Dokumente kann anschließend
					per Drag & Drop oder mit den Pfeiltasten geändert werden.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-merge-drop-zone"
			for="pdf-merge-files"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDFs auswählen
			</strong>
			<span>
				oder mehrere Dateien hier ablegen
			</span>
			<small>
				Max. 50 Dateien · 512 MiB pro Datei · 1 GiB gesamt
			</small>
			<input
				id="pdf-merge-files"
				type="file"
				accept="application/pdf,.pdf"
				multiple
				hidden
			/>
		</label>
		<div
			id="pdf-merge-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span id="pdf-upload-progress-text">
					Upload und Seitenvorschau werden erstellt.
				</span>
			</div>
		</div>
		<section
			id="pdf-merge-selection"
			class="pdf-selection"
			hidden
		>
			<header class="pdf-selection-header">
				<div>
					<strong>
						Reihenfolge
					</strong>
					<span id="pdf-merge-count">
						0 Dateien
					</span>
				</div>
				<button
					id="pdf-merge-clear"
					class="pdf-button-secondary"
					type="button"
				>
					Alle entfernen
				</button>
			</header>
			<div
				id="pdf-merge-list"
				class="pdf-file-list"
			></div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						zusammengefuegt.pdf
					</span>
				</div>
				<button
					id="pdf-merge-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					PDFs zusammenfügen
				</button>
			</div>
		</section>
		<div
			id="pdf-merge-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDFs werden zusammengefügt …
				</strong>
				<span>
					Bitte diese Seite geöffnet lassen.
				</span>
			</div>
		</div>
		@PDFMergeDocumentTemplate()
		@PDFPagePreviewTemplate("pdf-merge-page-template")
	</div>
}

templ PDFSortWorkspace() {
	<div data-pdf-workspace="sort">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					Seiten sortieren
				</h3>
				<p>
					Lade eine PDF hoch und ziehe die Seiten anschließend
					in die gewünschte Reihenfolge.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-sort-drop-zone"
			for="pdf-sort-file"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDF auswählen
			</strong>
			<span>
				oder eine Datei hier ablegen
			</span>
			<small>
				Max. 512 MiB
			</small>
			<input
				id="pdf-sort-file"
				type="file"
				accept="application/pdf,.pdf"
				hidden
			/>
		</label>
		<div
			id="pdf-sort-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-sort-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span>
					Datei wird hochgeladen und analysiert.
				</span>
			</div>
		</div>
		<section
			id="pdf-sort-editor"
			class="pdf-sort-editor"
			hidden
		>
			<header class="pdf-sort-header">
				<div>
					<strong id="pdf-sort-filename"></strong>
					<span id="pdf-sort-meta"></span>
				</div>
				<button
					id="pdf-sort-reset-file"
					class="pdf-button-secondary"
					type="button"
				>
					Andere PDF
				</button>
			</header>
			<div
				id="pdf-sort-pages"
				class="pdf-sort-pages"
				aria-label="PDF-Seiten"
			></div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						sortiert.pdf
					</span>
				</div>
				<button
					id="pdf-sort-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					Sortierte PDF erstellen
				</button>
			</div>
		</section>
		<div
			id="pdf-sort-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird erstellt …
				</strong>
				<span>
					Die Seiten werden in die neue Reihenfolge übernommen.
				</span>
			</div>
		</div>
		@PDFSortPageTemplate()
	</div>
}

templ PDFDeleteWorkspace() {
	<div data-pdf-workspace="delete">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					Seiten löschen
				</h3>
				<p>
					Wähle die Seiten aus, die aus der PDF entfernt werden sollen.
					Mehrere Seiten können einzeln oder mit Umschalt + Klick ausgewählt werden.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-delete-drop-zone"
			for="pdf-delete-file"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDF auswählen
			</strong>
			<span>
				oder eine Datei hier ablegen
			</span>
			<small>
				Max. 512 MiB
			</small>
			<input
				id="pdf-delete-file"
				type="file"
				accept="application/pdf,.pdf"
				hidden
			/>
		</label>
		<div
			id="pdf-delete-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-delete-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span>
					Datei wird hochgeladen und analysiert.
				</span>
			</div>
		</div>
		<section
			id="pdf-delete-editor"
			class="pdf-delete-editor"
			hidden
		>
			<header class="pdf-delete-header">
				<div>
					<strong id="pdf-delete-filename"></strong>
					<span id="pdf-delete-meta"></span>
				</div>
				<button
					id="pdf-delete-reset-file"
					class="pdf-button-secondary"
					type="button"
				>
					Andere PDF
				</button>
			</header>
			<div class="pdf-delete-selection-bar">
				<div>
					<strong>
						Seitenauswahl
					</strong>
					<span id="pdf-delete-selected-count">
						0 Seiten ausgewählt
					</span>
				</div>
				<div class="pdf-delete-selection-actions">
					<button
						id="pdf-delete-select-all"
						class="pdf-button-secondary"
						type="button"
					>
						Alle auswählen
					</button>
					<button
						id="pdf-delete-clear-selection"
						class="pdf-button-secondary"
						type="button"
						disabled
					>
						Auswahl aufheben
					</button>
				</div>
			</div>
			<div
				id="pdf-delete-pages"
				class="pdf-page-selector"
				aria-label="PDF-Seiten auswählen"
			></div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						seiten-entfernt.pdf
					</span>
				</div>
				<button
					id="pdf-delete-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					Ausgewählte Seiten löschen
				</button>
			</div>
		</section>
		<div
			id="pdf-delete-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird erstellt …
				</strong>
				<span>
					Die ausgewählten Seiten werden entfernt.
				</span>
			</div>
		</div>
		@PDFSelectablePageTemplate()
	</div>
}

templ PDFMergeDocumentTemplate() {
	<template id="pdf-merge-document-template">
		<article
			class="pdf-file-item"
			draggable="true"
		>
			<div class="pdf-file-header">
				<span
					class="pdf-file-drag"
					title="Dokument verschieben"
					aria-hidden="true"
				>
					⠿
				</span>
				<span class="pdf-file-index"></span>
				<div class="pdf-file-info">
					<strong class="pdf-file-name"></strong>
					<span class="pdf-file-meta"></span>
				</div>
				<div class="pdf-file-actions">
					<button
						type="button"
						data-action="move-up"
						title="Nach oben"
						aria-label="Dokument nach oben verschieben"
					>
						↑
					</button>
					<button
						type="button"
						data-action="move-down"
						title="Nach unten"
						aria-label="Dokument nach unten verschieben"
					>
						↓
					</button>
					<button
						type="button"
						data-action="remove"
						title="Entfernen"
						aria-label="Dokument entfernen"
					>
						×
					</button>
				</div>
			</div>
			<div
				class="pdf-page-strip"
				tabindex="0"
				aria-label="Seitenvorschau"
			></div>
		</article>
	</template>
}

templ PDFPagePreviewTemplate(
	id string,
) {
	<template id={ id }>
		<figure class="pdf-page-preview">
			<div class="pdf-page-image">
				<img
					loading="lazy"
					decoding="async"
					alt=""
				/>
			</div>
			<figcaption></figcaption>
		</figure>
	</template>
}

templ PDFSortPageTemplate() {
	<template id="pdf-sort-page-template">
		<article
			class="pdf-sort-page"
			draggable="true"
		>
			<div class="pdf-sort-page-position"></div>
			<div class="pdf-page-image">
				<img
					loading="lazy"
					decoding="async"
					alt=""
				/>
			</div>
			<div class="pdf-sort-page-footer">
				<span class="pdf-sort-page-original"></span>
				<span
					class="pdf-sort-page-drag"
					aria-hidden="true"
				>
					⠿
				</span>
			</div>
		</article>
	</template>
}

templ PDFSelectablePageTemplate() {
	<template id="pdf-select-page-template">
		<button
			class="pdf-select-page"
			type="button"
			aria-pressed="false"
		>
			<span class="pdf-select-page-number"></span>
			<span class="pdf-select-page-check" aria-hidden="true">
				✓
			</span>
			<span class="pdf-select-page-image">
				<img
					loading="lazy"
					decoding="async"
					alt=""
				/>
			</span>
			<span class="pdf-select-page-footer"></span>
		</button>
	</template>
}

templ PDFPlaceholderWorkspace(
	title string,
) {
	<div data-pdf-workspace="placeholder">
		@PDFWorkspaceBackButton()
		<div class="pdf-tool-placeholder">
			<strong>
				{ title }
			</strong>
			<span>
				Dieses Werkzeug bauen wir als Nächstes.
			</span>
		</div>
	</div>
}

templ PDFWorkspaceBackButton() {
	<div class="pdf-workspace-navigation">
		<button
			class="pdf-back-button"
			type="button"
			data-pdf-back
		>
			<span aria-hidden="true">
				←
			</span>
			<span>
				Zurück zu PDF-Werkzeugen
			</span>
		</button>
	</div>
}
