package view

import (
	"strings"

	"github.com/jayzone91/media-converter/internal/media"
)

templ DetectResult(
	uploadID string,
	filename string,
	format media.Format,
) {
	<input
		type="hidden"
		name="upload_id"
		value={ uploadID }
	/>
	<div class="detected-file">
		<div>
			<span class="label">
				Datei
			</span>
			<strong class="filename">
				{ filename }
			</strong>
		</div>
		<span class="format-badge">
			{ strings.ToUpper(format.ID) }
		</span>
	</div>
	<div class="target-section">
		<label
			class="label"
			for="target"
		>
			Konvertieren nach
		</label>
		<select
			id="target"
			name="target"
			class="target-select"
			required
		>
			<option
				value=""
				selected
				disabled
			>
				Zielformat auswählen
			</option>
			for _, target := range format.Targets {
				<option value={ target }>
					{ strings.ToUpper(target) }
				</option>
			}
		</select>
	</div>
	<button
		class="convert-button"
		type="submit"
	>
		Konvertieren
	</button>
}

templ DetectError(
	message string,
) {
	<div class="detect-error">
		{ message }
	</div>
}
