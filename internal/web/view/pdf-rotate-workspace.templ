package view

templ PDFRotateWorkspace() {
	<div data-pdf-workspace="rotate">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					Seiten drehen
				</h3>
				<p>
					Drehe einzelne Seiten direkt in der Vorschau.
					Jede Seite kann unabhängig beliebig oft nach links oder rechts gedreht werden.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-rotate-drop-zone"
			for="pdf-rotate-file"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDF auswählen
			</strong>
			<span>
				oder eine Datei hier ablegen
			</span>
			<small>
				Max. 512 MiB
			</small>
			<input
				id="pdf-rotate-file"
				type="file"
				accept="application/pdf,.pdf"
				hidden
			/>
		</label>
		<div
			id="pdf-rotate-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-rotate-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span>
					Datei wird hochgeladen und analysiert.
				</span>
			</div>
		</div>
		<section
			id="pdf-rotate-editor"
			class="pdf-selection-editor"
			hidden
		>
			<header class="pdf-selection-header">
				<div>
					<strong id="pdf-rotate-filename"></strong>
					<span id="pdf-rotate-meta"></span>
				</div>
				<button
					id="pdf-rotate-reset-file"
					class="pdf-button-secondary"
					type="button"
				>
					Andere PDF
				</button>
			</header>
			<div class="pdf-rotate-toolbar">
				<div>
					<strong>
						Seitendrehung
					</strong>
					<span id="pdf-rotate-changed-count">
						Keine Seiten geändert
					</span>
				</div>
				<button
					id="pdf-rotate-reset-rotations"
					class="pdf-button-secondary"
					type="button"
					disabled
				>
					Alle Drehungen zurücksetzen
				</button>
			</div>
			<div
				id="pdf-rotate-pages"
				class="pdf-page-selector"
				aria-label="PDF-Seiten drehen"
			></div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						gedreht.pdf
					</span>
				</div>
				<button
					id="pdf-rotate-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					PDF erstellen
				</button>
			</div>
		</section>
		<div
			id="pdf-rotate-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird erstellt …
				</strong>
				<span>
					Die Seitendrehungen werden übernommen.
				</span>
			</div>
		</div>
		@PDFRotatePageTemplate()
	</div>
}

templ PDFRotatePageTemplate() {
	<template id="pdf-rotate-page-template">
		<article class="pdf-rotate-page">
			<span class="pdf-rotate-page-number"></span>
			<div class="pdf-rotate-page-preview">
				<div class="pdf-rotate-page-frame">
					<img
						loading="lazy"
						decoding="async"
						alt=""
					/>
				</div>
			</div>
			<div class="pdf-rotate-page-controls">
				<button
					type="button"
					data-rotate="left"
					title="90° nach links drehen"
					aria-label="Seite 90 Grad nach links drehen"
				>
					↶
				</button>
				<span class="pdf-rotate-page-angle">
					Original
				</span>
				<button
					type="button"
					data-rotate="right"
					title="90° nach rechts drehen"
					aria-label="Seite 90 Grad nach rechts drehen"
				>
					↷
				</button>
			</div>
		</article>
	</template>
}
