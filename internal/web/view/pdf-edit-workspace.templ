package view

templ PDFEditWorkspace() {
	<div data-pdf-workspace="edit">
		@PDFWorkspaceBackButton()
		<div class="pdf-workspace-header">
			<div>
				<span class="eyebrow">
					PDF
				</span>
				<h3>
					PDF bearbeiten
				</h3>
				<p>
					Füge Text, Bilder und Freihandzeichnungen auf bestehenden
					PDF-Seiten hinzu, ohne die Originalseiten neu zu rendern.
				</p>
			</div>
		</div>
		<label
			class="pdf-drop-zone"
			id="pdf-edit-drop-zone"
			for="pdf-edit-file"
		>
			<span class="pdf-drop-icon">
				↑
			</span>
			<strong>
				PDF auswählen
			</strong>
			<span>
				oder eine Datei hier ablegen
			</span>
			<small>
				Max. 512 MiB
			</small>
			<input
				id="pdf-edit-file"
				type="file"
				accept="application/pdf,.pdf"
				hidden
			/>
		</label>
		<div
			id="pdf-edit-error"
			class="pdf-message pdf-message-error"
			hidden
		></div>
		<div
			id="pdf-edit-upload-progress"
			class="pdf-progress"
			hidden
		>
			<span class="small-spinner"></span>
			<div>
				<strong>
					PDF wird vorbereitet …
				</strong>
				<span>
					Datei wird hochgeladen und analysiert.
				</span>
			</div>
		</div>
		<section
			id="pdf-edit-editor"
			class="pdf-edit-editor"
			hidden
		>
			<header class="pdf-selection-header">
				<div>
					<strong id="pdf-edit-filename"></strong>
					<span id="pdf-edit-meta"></span>
				</div>
				<button
					id="pdf-edit-reset-file"
					class="pdf-button-secondary"
					type="button"
				>
					Andere PDF
				</button>
			</header>
			<div class="pdf-edit-layout">
				<aside
					id="pdf-edit-pages"
					class="pdf-edit-pages"
					aria-label="PDF-Seiten"
				></aside>
				<section class="pdf-edit-work-area">
					<div class="pdf-edit-toolbar">
						<button
							id="pdf-edit-add-text"
							class="pdf-button-secondary"
							type="button"
						>
							＋ Text
						</button>
						<button
							id="pdf-edit-add-image"
							class="pdf-button-secondary"
							type="button"
						>
							＋ Bild
						</button>
						<input
							id="pdf-edit-image-file"
							type="file"
							accept="image/png,image/jpeg,.png,.jpg,.jpeg"
							hidden
						/>
						<button
							id="pdf-edit-draw-toggle"
							class="pdf-button-secondary"
							type="button"
							aria-pressed="false"
						>
							✎ Freihand
						</button>
						<span
							id="pdf-edit-toolbar-note"
							class="pdf-edit-toolbar-note"
						>
							Elemente hinzufügen und frei auf der Seite positionieren.
						</span>
					</div>
					<div
						id="pdf-edit-text-properties"
						class="pdf-edit-properties"
						hidden
					>
						<div class="pdf-edit-property pdf-edit-property-text">
							<label for="pdf-edit-text-content">
								Text
							</label>
							<input
								id="pdf-edit-text-content"
								type="text"
								maxlength="500"
								autocomplete="off"
							/>
						</div>
						<div class="pdf-edit-property">
							<label for="pdf-edit-text-size">
								Schriftgröße
							</label>
							<div class="pdf-edit-size-field">
								<input
									id="pdf-edit-text-size"
									type="number"
									min="6"
									max="144"
									step="1"
									value="18"
								/>
								<span>pt</span>
							</div>
						</div>
						<div class="pdf-edit-property">
							<label for="pdf-edit-text-color">
								Farbe
							</label>
							<input
								id="pdf-edit-text-color"
								class="pdf-edit-color-input"
								type="color"
								value="#000000"
							/>
						</div>
						<button
							id="pdf-edit-delete-text"
							class="pdf-edit-delete-object"
							type="button"
						>
							Text löschen
						</button>
					</div>
					<div
						id="pdf-edit-image-properties"
						class="pdf-edit-properties pdf-edit-image-properties"
						hidden
					>
						<div class="pdf-edit-property pdf-edit-property-text">
							<label>
								Bild
							</label>
							<div
								id="pdf-edit-image-name"
								class="pdf-edit-image-name"
							></div>
						</div>
						<div class="pdf-edit-property">
							<label for="pdf-edit-image-width">
								Breite
							</label>
							<div class="pdf-edit-size-field">
								<input
									id="pdf-edit-image-width"
									type="number"
									min="5"
									max="100"
									step="1"
									value="25"
								/>
								<span>%</span>
							</div>
						</div>
						<button
							id="pdf-edit-delete-image"
							class="pdf-edit-delete-object"
							type="button"
						>
							Bild löschen
						</button>
					</div>
					<div
						id="pdf-edit-draw-properties"
						class="pdf-edit-properties pdf-edit-draw-properties"
						hidden
					>
						<div class="pdf-edit-property">
							<label for="pdf-edit-draw-color">
								Farbe
							</label>
							<input
								id="pdf-edit-draw-color"
								class="pdf-edit-color-input"
								type="color"
								value="#dc2626"
							/>
						</div>
						<div class="pdf-edit-property">
							<label for="pdf-edit-draw-width">
								Strichstärke
							</label>
							<div class="pdf-edit-size-field">
								<input
									id="pdf-edit-draw-width"
									type="number"
									min="1"
									max="20"
									step="1"
									value="3"
								/>
								<span>pt</span>
							</div>
						</div>
						<button
							id="pdf-edit-draw-undo"
							class="pdf-button-secondary"
							type="button"
							disabled
						>
							↶ Letzten Strich
						</button>
						<button
							id="pdf-edit-draw-clear"
							class="pdf-edit-delete-object"
							type="button"
							disabled
						>
							Zeichnung löschen
						</button>
					</div>
					<div class="pdf-edit-canvas-shell">
						<div
							id="pdf-edit-canvas"
							class="pdf-edit-canvas"
						>
							<img
								id="pdf-edit-page-preview"
								class="pdf-edit-page-preview"
								alt=""
							/>
							<div
								id="pdf-edit-image-overlay"
								class="pdf-edit-overlay"
								aria-label="Bildebene"
							></div>
							<div
								id="pdf-edit-overlay"
								class="pdf-edit-overlay"
								aria-label="Textebene"
							></div>
							<svg
								id="pdf-edit-draw-overlay"
								class="pdf-edit-draw-overlay"
								aria-label="Zeichenebene"
								preserveAspectRatio="none"
							></svg>
						</div>
					</div>
				</section>
			</div>
			<div class="pdf-action-row">
				<div>
					<strong>
						Ausgabe
					</strong>
					<span>
						bearbeitet.pdf
					</span>
				</div>
				<button
					id="pdf-edit-submit"
					class="pdf-button-primary"
					type="button"
					disabled
				>
					PDF erstellen
				</button>
			</div>
		</section>
		<template id="pdf-edit-page-template">
			<button
				class="pdf-edit-page"
				type="button"
			>
				<span class="pdf-edit-page-number"></span>
				<img
					loading="lazy"
					decoding="async"
					alt=""
				/>
				<span
					class="pdf-edit-page-change-indicator"
					hidden
					aria-label="Seite wurde bearbeitet"
				>
					●
				</span>
			</button>
		</template>
	</div>
}
