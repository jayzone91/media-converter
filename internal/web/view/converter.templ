package view

templ ConverterPanel() {
	<section
		class="tab-panel active"
		data-panel="converter"
	>
		<section class="tool-panel">
			<header class="panel-header">
				<h2>
					Medien konvertieren
				</h2>
				<p>
					Bilder, Audio, Video, Dokumente und PDF
					in unterstützte Zielformate konvertieren.
				</p>
			</header>
			<form
				id="conversion-form"
				class="conversion-form"
				action="/convert"
				method="post"
				enctype="multipart/form-data"
			>
				<label
					class="drop-zone"
					for="file"
				>
					<span class="drop-icon">
						↑
					</span>
					<span class="drop-title">
						Dateien auswählen
					</span>
					<span class="drop-description">
						oder hier ablegen
					</span>
					<span class="drop-limit">
						Bis zu 20 Dateien gleichen Typs,
						insgesamt maximal 512 MiB
					</span>
					<input
						id="file"
						class="file-input"
						type="file"
						name="file"
						multiple
						required
						hx-post="/detect"
						hx-trigger="change"
						hx-target="#conversion-options"
						hx-swap="innerHTML"
						hx-encoding="multipart/form-data"
						hx-include="closest form"
						hx-indicator="#detect-indicator"
					/>
				</label>
				<div
					id="detect-indicator"
					class="indicator htmx-indicator"
				>
					<span class="small-spinner"></span>
					Dateien werden analysiert …
				</div>
				<section
					id="conversion-options"
					class="conversion-options"
					aria-live="polite"
				>
					<div class="empty-state">
						Wähle eine oder mehrere Dateien gleichen Typs aus,
						um die verfügbaren Zielformate anzuzeigen.
					</div>
				</section>
				<div
					id="conversion-error"
					class="conversion-error"
					hidden
				></div>
			</form>
		</section>
	</section>
}
