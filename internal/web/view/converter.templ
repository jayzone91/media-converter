package view

templ ConverterPanel() {
	<section
		class="tab-panel active"
		data-panel="converter"
	>
		<section class="tool-panel">
			<header class="panel-header">
				<h2>
					Medien konvertieren
				</h2>
				<p>
					Bilder, Audio, Video, Dokumente und PDF
					in unterstützte Zielformate konvertieren.
				</p>
			</header>
			<form
				id="conversion-form"
				class="conversion-form"
				action="/convert"
				method="post"
				enctype="multipart/form-data"
			>
				<label
					class="drop-zone"
					for="file"
				>
					<span class="drop-icon">
						↑
					</span>
					<span class="drop-title">
						Dateien auswählen
					</span>
					<span class="drop-description">
						oder hier ablegen
					</span>
					<span class="drop-limit">
						Bis zu 20 Dateien gleichen Typs,
						insgesamt maximal 512 MiB
					</span>
					<input
						id="file"
						class="file-input"
						type="file"
						name="file"
						multiple
						required
						hx-post="/detect"
						hx-trigger="change"
						hx-target="#conversion-options"
						hx-swap="innerHTML"
						hx-encoding="multipart/form-data"
						hx-include="closest form"
						hx-indicator="#detect-indicator"
					/>
				</label>
				<details class="supported-formats">
					<summary>
						Unterstützte Eingabeformate
					</summary>
					<div class="supported-formats-grid">
						<section class="supported-format-group">
							<h3>Bilder</h3>
							<p>
								JPEG, PNG, WEBP, AVIF, HEIC, HEIF,
								TIFF, BMP, GIF, SVG
							</p>
						</section>
						<section class="supported-format-group">
							<h3>Audio</h3>
							<p>
								MP3, WAV, FLAC, OGG, OPUS,
								AAC, M4A, WMA
							</p>
						</section>
						<section class="supported-format-group">
							<h3>Video</h3>
							<p>
								MP4, M4V, MKV, WEBM, MOV,
								AVI, MPEG, MPG, WMV, FLV
							</p>
						</section>
						<section class="supported-format-group">
							<h3>Dokumente</h3>
							<p>
								DOCX, ODT, XLSX, ODS, PPTX,
								ODP, RTF, TXT
							</p>
						</section>
						<section class="supported-format-group">
							<h3>Markdown</h3>
							<p>
								MD, MDX, MARKDOWN
							</p>
						</section>
						<section class="supported-format-group">
							<h3>PDF</h3>
							<p>
								PDF
							</p>
						</section>
					</div>
				</details>
				<div
					id="detect-indicator"
					class="indicator htmx-indicator"
				>
					<span class="small-spinner"></span>
					Dateien werden analysiert …
				</div>
				<section
					id="conversion-options"
					class="conversion-options"
					aria-live="polite"
				>
					<div class="empty-state">
						Wähle eine oder mehrere Dateien gleichen Typs aus,
						um die verfügbaren Zielformate anzuzeigen.
					</div>
				</section>
				<div
					id="conversion-error"
					class="conversion-error"
					hidden
				></div>
			</form>
		</section>
	</section>
}
